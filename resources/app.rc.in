#include <windows.h>

// Icon generated at build time by ro_icon_gen (no binary asset in the repo).
IDI_APPICON ICON "@RO_ICON_FILE_RC@"

// Side-by-side manifest: PerMonitorV2 DPI, no auto-elevation, Win10/11 aware.
// MinGW's linker injects its own default manifest, so the resource is only
// added for MSVC (RO_MANIFEST_RESOURCE is empty otherwise).
@RO_MANIFEST_RESOURCE@

VS_VERSION_INFO VERSIONINFO
 FILEVERSION @RO_VERSION_COMMA@
 PRODUCTVERSION @RO_VERSION_COMMA@
 FILEFLAGSMASK 0x3fL
#ifdef _DEBUG
 FILEFLAGS VS_FF_DEBUG
#else
 FILEFLAGS 0x0L
#endif
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Rust Optimizer"
            VALUE "FileDescription", "Rust Optimizer - external performance engine for RUST and FORTNITE"
            VALUE "FileVersion", "@RO_VERSION_STRING@"
            VALUE "InternalName", "RustOptimizer"
            VALUE "LegalCopyright", "MIT License"
            VALUE "OriginalFilename", "RustOptimizer.exe"
            VALUE "ProductName", "Rust Optimizer"
            VALUE "ProductVersion", "@RO_VERSION_STRING@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
